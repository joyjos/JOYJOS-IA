# ==============================================
# .htaccess ULTRA PRO para JOYJOS
# ==============================================

ErrorDocument 404 /error404.html 

# 1️⃣ Activar motor de reescritura
RewriteEngine On

# 2️⃣ Redirigir HTTP a HTTPS (Global)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3️⃣ Redirigir www → sin www (HTTPS)
RewriteCond %{HTTP_HOST} ^www\.joyjos\.eu$ [NC]
RewriteRule ^(.*)$ https://joyjos.eu/$1 [L,R=301]

# 4️⃣ Evitar hotlinking de imágenes
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://joyjos.eu/ [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC,L]

# 5️⃣ Negociación de Contenido: Markdown para Agentes de IA
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{REQUEST_URI} ^/(index\.html)?$
RewriteRule ^ /llms.txt [L]

# Permitir acceso directo a .well-known
RewriteRule ^\.well-known/ - [L]

# 6️⃣ Compresión Gzip para archivos comunes
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/linkset+json text/markdown
</IfModule>

# 7️⃣ Cacheo de navegador para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 year"
  ExpiresByType application/linkset+json "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"
</IfModule>

# 8️⃣ Tipos MIME para endpoints de descubrimiento de agentes
<Files "api-catalog">
  ForceType "application/linkset+json; charset=utf-8"
</Files>
<Files "oauth-protected-resource">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "oauth-authorization-server">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "openid-configuration">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "health">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "server-card.json">
  ForceType "application/mcp-server-card+json; charset=utf-8"
</Files>
<Files "ai-catalog.json">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "llms.txt">
  ForceType "text/markdown; charset=utf-8"
</Files>
<Files "auth.md">
  ForceType "text/markdown; charset=utf-8"
</Files>

# 9️⃣ Cabeceras de Seguridad y Descubrimiento para Agentes
<IfModule mod_headers.c>
  # Enforce HTTPS (HSTS) - 1 año incl. subdominios y preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Evitar clickjacking
  Header always append X-Frame-Options SAMEORIGIN
  
  # Evitar sniffing de tipo de contenido
  Header set X-Content-Type-Options nosniff
  
  # Referrer Policy: privacidad al navegar hacia fuera
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Content Security Policy (CSP) - Blindaje Total
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'none'; object-src 'none';"
  
  # Permissions Policy: Deshabilitar acceso a hardware innecesario
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Variar caché según el header Accept para negociación de contenido
  Header append Vary "Accept"

  # Link response headers para descubrimiento de agentes (RFC 8288 & RFC 9727)
  Header set Link '</.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="ai-catalog", </.well-known/mcp/server-card.json>; rel="service-desc", </llms.txt>; rel="service-doc", </llms.txt>; rel="alternate"; type="text/markdown", </auth.md>; rel="describedby"'

  # CORS y tokens para recursos de agentes
  <FilesMatch "^(api-catalog|oauth-protected-resource|oauth-authorization-server|openid-configuration|server-card\.json|ai-catalog\.json|index\.json|openapi\.json|health)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  <Files "llms.txt">
    Header set Access-Control-Allow-Origin "*"
    Header set x-markdown-tokens "1500"
    Header set Content-Type "text/markdown; charset=utf-8"
  </Files>

  <Files "auth.md">
    Header set Access-Control-Allow-Origin "*"
  </Files>
</IfModule>

# 🔟 Deshabilitar firmas del servidor y listado de directorios
Options -Indexes
ServerSignature Off

# Evitar bucles de redirección
RewriteCond %{ENV:REDIRECT_STATUS} ^$